{
  // Tests import the built declarations from `dist/`, so they are checked by their
  // own config: `composite`/`rootDir` are the source build's concern, and the test
  // runner strips types rather than checking them. Run after `tsc --build`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Shared test helpers are imported as .ts files, which Node runs directly.
    "allowImportingTsExtensions": true,
    "composite": false,
    "rootDir": "."
  },
  "include": ["test/**/*.ts"]
}
