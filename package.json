{
  "name": "@tycoworks/tycoslide",
  "version": "0.17.3",
  "description": "Create editable PowerPoint slides from markdown, using your existing .pptx templates.",
  "author": "tycoworks",
  "homepage": "https://github.com/tycoworks/tycoslide",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tycoworks/tycoslide.git"
  },
  "bugs": "https://github.com/tycoworks/tycoslide/issues",
  "license": "MIT",
  "keywords": [
    "markdown",
    "powerpoint",
    "pptx",
    "slides",
    "presentation",
    "slides-as-code",
    "agent-skills",
    "claude-code"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tycoslide": "bin/tycoslide.js"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "theme-package"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "tsc --build && tsc -p tsconfig.test.json && node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --build && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "commander": "^15.0.0",
    "image-size": "^2.0.4",
    "jszip": "^3.10.1",
    "mermaid": "^11.16.1",
    "playwright-core": "^1.62.1",
    "pptx-automizer": "^0.8.2",
    "remark-gfm": "^4.0.1",
    "remark-ins": "^1.2.5",
    "remark-parse": "^11.0.0",
    "shiki": "^4.3.0",
    "unified": "^11.0.0",
    "yaml": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^24.19.2",
    "typescript": "^5.8.0"
  }
}
